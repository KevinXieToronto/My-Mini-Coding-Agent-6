{
    "name": "pi-monorepo",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "clean": "npm run clean --workspaces",
        "build": "cd packages/tui && npm run build && cd ../ai && npm run build && cd ../agent && npm run build && cd ../coding-agent && npm run build",
        "check": "biome check --write --error-on-warnings . && npm run check:pinned-deps && npm run check:ts-imports && tsgo --noEmit",
        "check:pinned-deps": "node scripts/check-pinned-deps.mjs",
        "check:ts-imports": "node scripts/check-ts-relative-imports.mjs",
        "test": "npm test --workspaces --if-present"
    },
    "devDependencies": {
        "@biomejs/biome": "2.3.5",
        "@types/node": "22.19.19",
        "@typescript/native-preview": "7.0.0-dev.20260120.1",
        "shx": "0.4.0",
        "tsx": "4.23.12",
        "typescript": "5.9.3",
        "vitest": "4.1.11"
    },
    "engines": {
        "node": ">=22.19.0"
    }
}
